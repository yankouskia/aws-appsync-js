{
  "name": "aws-appsync-js",
  "version": "1.0.1",
  "description": "A tiny, fully-typed, zero-dependency AWS AppSync (GraphQL) client for Node and the browser. Supports all 5 AppSync auth modes, AbortSignal, retries, and end-to-end TypeScript inference via TypedDocumentNode.",
  "keywords": [
    "aws",
    "appsync",
    "graphql",
    "graphql-client",
    "typescript",
    "typed-document-node",
    "fetch",
    "sigv4",
    "iam",
    "cognito",
    "oidc",
    "edge",
    "esm",
    "tree-shakable",
    "zero-dependencies"
  ],
  "homepage": "https://yankouskia.github.io/aws-appsync-js",
  "bugs": {
    "url": "https://github.com/yankouskia/aws-appsync-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankouskia/aws-appsync-js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aliaksandr Yankouski",
    "email": "aleksandr.yankovskiy@gmail.com",
    "url": "https://github.com/yankouskia"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/yankouskia"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage docs/api .tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "size": "size-limit",
    "validate:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run validate:package",
    "release": "changeset publish",
    "prepare": "lefthook install >/dev/null 2>&1 || true"
  },
  "peerDependencies": {
    "@graphql-typed-document-node/core": ">=3.2.0",
    "graphql": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "@graphql-typed-document-node/core": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.11",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "graphql": "^16.10.0",
    "lefthook": "^1.10.0",
    "lint-staged": "^15.3.0",
    "publint": "^0.3.2",
    "size-limit": "^11.2.0",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
